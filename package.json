{
  "name": "@terruar/variants-gallery",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite",
    "clear": "rm -rf dist",
    "lint": "bun oxlint && bun oxfmt",
    "build:app": "bun --bun vite build && bun run build.ts",
    "docker:dev:up": "docker compose -f docker-compose.yml -f docker-compose-dev.yml up",
    "server:start": "bun --bun dist/server.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.28"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/pdfjs-dist": "^2.10.378",
    "@vitejs/plugin-vue": "^6.0.7",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "p-limit": "^7.3.0",
    "schema-dts": "^2.0.0",
    "vite": "^8.0.13",
    "vue": "^3.5.34",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
